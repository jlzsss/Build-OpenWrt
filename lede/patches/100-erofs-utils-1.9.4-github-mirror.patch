--- a/tools/erofs-utils/Makefile
+++ b/tools/erofs-utils/Makefile
@@ -7,12 +7,24 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=erofs-utils
-PKG_VERSION:=1.8.10
+PKG_VERSION:=1.9.4
 PKG_RELEASE:=1
 
-PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
-PKG_SOURCE_URL=https://git.kernel.org/pub/scm/linux/kernel/git/xiang/erofs-utils.git/snapshot/
-PKG_HASH:=05eb4edebe11decce6ecb34e98d2f80c8cd283c2f2967d8ba7efd58418570514
+# Keep erofs-utils in sync with Immortalwrt (1.9.4, commit f36cadb5).
+# git.kernel.org throttles/blocks GitHub Actions egress IPs, so use the
+# GitHub mirror instead. OpenWrt repacks the source deterministically
+# (DownloadMethod/rawgit or scripts/dl_github_archive.py with xz -7e),
+# so PKG_MIRROR_HASH below is the sha256 of the repacked tarball.
+# Note: the tarball is packed as .tar.xz (deterministic) rather than
+# Immortalwrt's default .tar.zst, whose zstd -T0 output is not
+# reproducible across zstd versions/thread counts.
+PKG_SOURCE_PROTO:=git
+PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.xz
+PKG_SOURCE_URL:=https://github.com/erofs/erofs-utils
+PKG_SOURCE_VERSION:=f36cadb5c563995ab3aa8572a60ed6b721b9557d
+PKG_SOURCE_DATE:=2026-08-19
+PKG_MIRROR_HASH:=239b4c3f56179157d0ad93260512370b4fd9feb75c85db05719b21f2e65a1c3b
+PKG_CPE_ID:=cpe:/a:erofs-utils_project:erofs-utils
 
 PKG_FIXUP:=autoreconf
 
