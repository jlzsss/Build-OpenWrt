Subject: [PATCH] clashoo: use nikki's mihomo instead of shipping its own

clashoo installs its own Go-built mihomo binary, conflicting with
feeds/packages/net/mihomo (and with nikki once nikki depends on the feed
mihomo). Drop mihomo from PROVIDES (keep clash-meta), depend on +nikki,
and stop installing the Go-built binary.

Applied to both providers: feeds/small and feeds/kenzok8 (jell).

NOTE: rewritten for the new upstream package layout (clashoo >=
2026.11.04, PKG_RELEASE 3). Upstream now installs its core into
/usr/libexec/clashoo/mihomo-stable and symlinks both /usr/bin/mihomo and
/usr/bin/clash-meta to it. We drop the Makefile part that ships the core
(GoPackage/Package/Install/Bin + the libexec mv/ln block) and keep only
the /usr/bin/clash-meta symlink, pointing at the feed's /usr/bin/mihomo,
so /usr/bin/mihomo comes solely from feeds/packages/net/mihomo.
The Go toolchain build itself stays intact (the binary is compiled but
not shipped); dropping the whole Go build would additionally require
GO_ARCH_DEPENDS/golang-package.mk cleanup.

--- a/feeds/small/clashoo/Makefile
+++ b/feeds/small/clashoo/Makefile
@@ -36,8 +36,8 @@
   SECTION:=net
   CATEGORY:=Network
   TITLE:=Clashoo (Mihomo)
-  DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +yq +firewall4 +ip-full +coreutils-nohup +coreutils-timeout +kmod-inet-diag +kmod-nft-socket +kmod-nft-tproxy +kmod-tun +kmod-dummy +unzip
-  PROVIDES:=mihomo clash-meta
+  DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +yq +firewall4 +ip-full +coreutils-nohup +coreutils-timeout +kmod-inet-diag +kmod-nft-socket +kmod-nft-tproxy +kmod-tun +kmod-dummy +unzip +nikki
+  PROVIDES:=clash-meta
 endef
 
 define Package/clashoo/description
@@ -49,13 +49,8 @@
 endef
 
 define Package/clashoo/install
-	$(call GoPackage/Package/Install/Bin,$(1))
-
-	$(INSTALL_DIR) $(1)/usr/libexec/clashoo
 	$(INSTALL_DIR) $(1)/usr/bin
-	mv -f $(1)/usr/bin/mihomo $(1)/usr/libexec/clashoo/mihomo-stable
-	ln -sf /usr/libexec/clashoo/mihomo-stable $(1)/usr/bin/mihomo
-	ln -sf /usr/libexec/clashoo/mihomo-stable $(1)/usr/bin/clash-meta
+	ln -sf /usr/bin/mihomo $(1)/usr/bin/clash-meta
 
 	$(INSTALL_DIR) $(1)/etc/init.d
 	$(INSTALL_DIR) $(1)/etc/config
--- a/feeds/kenzok8/clashoo/Makefile
+++ b/feeds/kenzok8/clashoo/Makefile
@@ -36,8 +36,8 @@
   SECTION:=net
   CATEGORY:=Network
   TITLE:=Clashoo (Mihomo)
-  DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +yq +firewall4 +ip-full +coreutils-nohup +coreutils-timeout +kmod-inet-diag +kmod-nft-socket +kmod-nft-tproxy +kmod-tun +kmod-dummy +unzip
-  PROVIDES:=mihomo clash-meta
+  DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +yq +firewall4 +ip-full +coreutils-nohup +coreutils-timeout +kmod-inet-diag +kmod-nft-socket +kmod-nft-tproxy +kmod-tun +kmod-dummy +unzip +nikki
+  PROVIDES:=clash-meta
 endef
 
 define Package/clashoo/description
@@ -49,13 +49,8 @@
 endef
 
 define Package/clashoo/install
-	$(call GoPackage/Package/Install/Bin,$(1))
-
-	$(INSTALL_DIR) $(1)/usr/libexec/clashoo
 	$(INSTALL_DIR) $(1)/usr/bin
-	mv -f $(1)/usr/bin/mihomo $(1)/usr/libexec/clashoo/mihomo-stable
-	ln -sf /usr/libexec/clashoo/mihomo-stable $(1)/usr/bin/mihomo
-	ln -sf /usr/libexec/clashoo/mihomo-stable $(1)/usr/bin/clash-meta
+	ln -sf /usr/bin/mihomo $(1)/usr/bin/clash-meta
 
 	$(INSTALL_DIR) $(1)/etc/init.d
 	$(INSTALL_DIR) $(1)/etc/config
