Subject: [PATCH] nikki: depend on feed mihomo instead of building its own

The in-feed nikki (feeds/packages/net/nikki) builds its own mihomo core
via GoBinPackage and PROVIDES mihomo, which file-conflicts with the
dedicated feeds/packages/net/mihomo package (/usr/bin/mihomo shipped
twice). Turn nikki into a pure config wrapper: drop the Go build
(PKG_BUILD_DEPENDS/GO_*/golang-package.mk/GoBinPackage/Install/Bin),
drop PROVIDES mihomo, depend on +mihomo, and ship a
/usr/libexec/nikki -> /usr/bin/mihomo symlink for the init scripts.

Converted from the nikki sed block in lede/diy-part3.sh via quilt
(quilt new/add/refresh against upstream coolsnowwolf/packages).
NOTE: the old '/PROVIDES:=mihomo/d' expression no longer matches the
current upstream line 'PROVIDES:=nikki mihomo' (a silent no-op that left
the conflict in place); this patch deletes that line explicitly.

--- a/feeds/packages/net/nikki/Makefile
+++ b/feeds/packages/net/nikki/Makefile
@@ -12,27 +12,21 @@ PKG_MIRROR_HASH:=858ca3e103f66ce1f2ed63a
 PKG_LICENSE:=GPL3.0+
 PKG_MAINTAINER:=Joseph Mory <morytyann@gmail.com>

-PKG_BUILD_DEPENDS:=golang/host
 PKG_BUILD_PARALLEL:=1
 PKG_BUILD_FLAGS:=no-mips16

 PKG_BUILD_VERSION:=alpha-32d447c
 PKG_BUILD_TIME:=$(shell date -u -Iseconds)

-GO_PKG:=github.com/metacubex/mihomo
-GO_PKG_LDFLAGS_X:=$(GO_PKG)/constant.Version=$(PKG_BUILD_VERSION) $(GO_PKG)/constant.BuildTime=$(PKG_BUILD_TIME)
-GO_PKG_TAGS:=with_gvisor

 include $(INCLUDE_DIR)/package.mk
-include $(TOPDIR)/feeds/packages/lang/golang/golang-package.mk

 define Package/nikki
   SECTION:=net
   CATEGORY:=Network
   TITLE:=A rule based proxy in Go.
   URL:=https://wiki.metacubex.one
-  DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +curl +yq firewall4 +ip-full +kmod-inet-diag +kmod-nft-socket +kmod-nft-tproxy +kmod-tun
-  PROVIDES:=nikki mihomo
+  DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +curl +yq firewall4 +ip-full +kmod-inet-diag +kmod-nft-socket +kmod-nft-tproxy +kmod-tun +mihomo
 endef

 define Package/nikki/description
@@ -47,7 +41,8 @@ define Package/nikki/conffiles
 endef

 define Package/nikki/install
-	$(call GoPackage/Package/Install/Bin,$(1))
+	$(INSTALL_DIR) $(1)/usr/libexec
+	$(LN) /usr/bin/mihomo $(1)/usr/libexec/nikki

 	$(INSTALL_DIR) $(1)/etc/nikki
 	$(INSTALL_DIR) $(1)/etc/nikki/ucode
@@ -105,5 +100,4 @@ define Build/Prepare
 	$(RM) -r $(PKG_BUILD_DIR)/rules/logic_test
 endef

-$(eval $(call GoBinPackage,nikki))
 $(eval $(call BuildPackage,nikki))
